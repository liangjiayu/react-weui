{
  "compilerOptions": {
    /* Base */
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "baseUrl": "./",

    /* Linting */
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* Bundler mode */
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,

    /* Others */
    "paths": {
      "@@/*": [".dumi/tmp/*"],
      "react-weui": ["components/index.ts"]
    }
  },
  "include": [".dumirc.ts", "**/*"],
  "exclude": ["node_modules", "dist"]
}
